

# Postgres user created by the db container
POSTGRES_USER=smartbin
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=smartbin
DATABASE_URL=postgresql+psycopg://smartbin:change-me-db@db:5432/smartbin

# MQTT broker host
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USER=smartbin-backend
MQTT_PASSWORD=change-me-mqtt
MQTT_TEST_DEVICE_PASSWORD=change-me-device
# The bin simulator logs in as its own user (Backend/simulator)
MQTT_SIM_USER=smartbin-simulator
MQTT_SIM_PASSWORD=change-me-sim

# Secret used to sign login tokens. At least 32 characters or the backend won't start.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# 5 failed logins within 10 minutes locks the account for 10 minutes
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MIN=10
LOCKOUT_MINUTES=10
# true = the refresh cookie is only sent over HTTPS. Keep false on laptops (plain http).
COOKIE_SECURE=false

# Frontends allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# OSRM server for road distances
OSRM_URL=https://router.project-osrm.org

# Profile photos: "local" keeps them in Backend/media (served at /media), "s3" in AWS S3.
STORAGE_BACKEND=local
# Only for STORAGE_BACKEND=s3. The bucket can stay private: photo links are presigned (1 hour).
S3_BUCKET=
S3_REGION=
# Empty for AWS. Set it only for other S3-compatible storage (e.g. http://minio:9000).
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Passwords for the seed users (Backend/scripts/seed.py)
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SUPERVISOR_PASSWORD=change-me-supervisor
SEED_COLLECTOR_PASSWORD=change-me-collector
