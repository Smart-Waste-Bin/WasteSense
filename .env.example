# SmartBin settings. Copy to .env and fill in the values: cp .env.example .env
# This root file is the only .env. docker compose and the backend both read it.
# Host names below are the docker compose service names (db, mqtt).
# If you run the backend outside Docker, change them to localhost.

# Postgres user created by the db container
POSTGRES_USER=smartbin
# Postgres password (pick your own, keep it the same in DATABASE_URL)
POSTGRES_PASSWORD=change-me-db
# Postgres database name
POSTGRES_DB=smartbin
# How the backend connects to Postgres (must match the three values above)
DATABASE_URL=postgresql+psycopg://smartbin:change-me-db@db:5432/smartbin

# MQTT broker host
MQTT_HOST=mqtt
# Plain MQTT port (dev only, password still required)
MQTT_PORT=1883
# MQTT over TLS port
MQTT_TLS_PORT=8883
# Backend's MQTT username (must match the "user" line in Infra/mosquitto/mosquitto.acl)
MQTT_USER=smartbin-backend
# Backend's MQTT password (pick your own, then re-run make-passwords)
MQTT_PASSWORD=change-me-mqtt
# Password for the test devices bin-001 and bin-002 (used by make-passwords and the tests)
MQTT_TEST_DEVICE_PASSWORD=change-me-device

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Frontends allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# OSRM server for road distances (public demo server, fine for dev)
OSRM_URL=https://router.project-osrm.org
