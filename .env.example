

# Postgres user created by the db container
POSTGRES_USER=smartbin
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=smartbin
DATABASE_URL=postgresql+psycopg://smartbin:change-me-db@db:5432/smartbin

# MQTT broker host
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USER=smartbin-backend
MQTT_PASSWORD=change-me-mqtt
MQTT_TEST_DEVICE_PASSWORD=change-me-device

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Frontends allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# OSRM server for road distances
OSRM_URL=https://router.project-osrm.org

# Passwords for the seed users (Backend/scripts/seed.py)
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SUPERVISOR_PASSWORD=change-me-supervisor
SEED_COLLECTOR_PASSWORD=change-me-collector
