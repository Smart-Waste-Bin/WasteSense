# Copy to .env.local and change what you need. All values are optional.

# Backend address (REST API and the /ws WebSocket)
VITE_API_URL=http://localhost:8000

# Live map base tiles (OpenStreetMap). Follow the tile usage policy:
# https://operations.osmfoundation.org/policies/tiles/
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Where the map opens when there are no bins: "lat,lng" (Kumasi), zoom level, and the closest zoom allowed
VITE_MAP_CENTER=6.6885,-1.6244
VITE_MAP_ZOOM=13
VITE_MAP_MAX_ZOOM=19
